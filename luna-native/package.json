    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
